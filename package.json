{
  "name": "dsh-taste",
  "version": "0.1.0",
  "description": "taste-skill 的 DeepSeek Harness 原生插件：把 design-taste-frontend 等技能与它的四个脚本（抽签 / 素材 / 静态检查 / 真实浏览器闸门）注册成 DSH 技能与工具，并可随上游自动重新封装",
  "license": "MIT",
  "author": "dsh-taste contributors",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "taste-skill",
    "design",
    "frontend",
    "anti-slop"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "LICENSE",
    "README.md",
    "cordis.patch.yml",
    "lib",
    "skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "vendor:check": "node scripts/vendor.mjs --check",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.1-rc.2"
  }
}
